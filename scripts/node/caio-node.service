[Unit]
# 子机节点程序:主动连主机 hub(出站 TLS 长连接),把主机发来的请求转给本机的
# dario 管理器 / dario 进程。不监听任何端口,所以 NAT、无公网 IP 的机器也能用。
Description=caio node agent (connects out to the caio hub)
Documentation=https://github.com/htesd/claude-all-in-one
After=network-online.target caio-dario.service
Wants=network-online.target
# 管理器没起来也照连:主机能看到「在线但管理器不可用」,比整台机器消失好查。
Wants=caio-dario.service

[Service]
Type=simple
User=caio
Group=caio
WorkingDirectory=/opt/caio
EnvironmentFile=/etc/caio/node.env
# 不要在这里写 Environment=CAIO_SUP_URL:systemd 里后出现的 Environment 会覆盖
# EnvironmentFile,那样 install.sh --sup-url 写进 node.env 的值就永远不生效
# (「给了参数、改了配置、行为没变」是最费时间的一类坑)。默认值由 install.sh 写进
# node.env,程序里也有同一个默认(gw_dario::DEFAULT_SUPERVISOR_URL)。
Environment=RUST_LOG=info
ExecStart=/opt/caio/bin/claude-all-in-one --mode node
Restart=always
# 令牌不对 / 已吊销时程序自己退避 5 分钟再试,这里只兜住进程级退出。
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
